import { generateAIContent } from './ai.js';
import { generateSlug, withRetry, log } from './utils.js';
import { config } from './config.js';

/**
 * Enrichit un lead avec son contenu IA généré
 * @param {Object} lead
 * @returns {Promise<Object>} lead enrichi
 */
async function processLead(lead) {
  const slug = generateSlug(lead);

  try {
    const aiContent = await withRetry(
      () => generateAIContent(lead),
      config.generation.retryAttempts,
      config.generation.retryDelay,
    );

    return {
      // Données originales du lead
      ...lead,

      // Métadonnées
      slug,
      processedAt: new Date().toISOString(),
      status: 'success',

      // Contenu IA
      content: aiContent,
    };
  } catch (error) {
    log('error', `Échec traitement lead "${lead.name}": ${error.message}`);

    return {
      ...lead,
      slug,
      processedAt: new Date().toISOString(),
      status: 'error',
      error: error.message,
      content: null,
    };
  }
}

/**
 * Traite un lot de leads en parallèle (avec limite de concurrence)
 * @param {Object[]} leads
 * @param {number} concurrency
 * @returns {Promise<Object[]>}
 */
async function processBatch(leads, concurrency) {
  const results = [];

  for (let i = 0; i < leads.length; i += concurrency) {
    const batch = leads.slice(i, i + concurrency);
    const batchNumber = Math.floor(i / concurrency) + 1;
    const totalBatches = Math.ceil(leads.length / concurrency);

    log('info', `Traitement lot ${batchNumber}/${totalBatches} (${batch.length} leads)`);

    const batchResults = await Promise.all(batch.map(processLead));
    results.push(...batchResults);
  }

  return results;
}

/**
 * Génère le contenu IA pour tous les leads
 * Point d'entrée principal du générateur
 *
 * @param {Object[]} leads - tableau de leads bruts
 * @returns {Promise<Object>} résultats avec stats
 */
export async function generateAllContent(leads) {
  if (!Array.isArray(leads) || leads.length === 0) {
    throw new Error('Aucun lead valide fourni au générateur');
  }

  log('info', `Démarrage génération pour ${leads.length} lead(s)`);

  const enrichedLeads = await processBatch(leads, config.generation.concurrency);

  const successful = enrichedLeads.filter(l => l.status === 'success');
  const failed = enrichedLeads.filter(l => l.status === 'error');

  log('info', `Génération terminée: ${successful.length} succès, ${failed.length} échecs`);

  if (failed.length > 0) {
    failed.forEach(l => log('warn', `Lead échoué: ${l.name} — ${l.error}`));
  }

  return {
    leads: enrichedLeads,
    stats: {
      total: leads.length,
      successful: successful.length,
      failed: failed.length,
    },
  };
}