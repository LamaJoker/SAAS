/**
 * Utilitaires partagés du système Auto-Demo
 */

/**
 * Convertit une chaîne en slug URL-friendly
 * @param {string} str
 * @returns {string}
 */
export function slugify(str) {
  if (!str || typeof str !== 'string') return '';

  return str
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '') // supprime les accents
    .replace(/[^a-z0-9\s-]/g, '')    // garde lettres, chiffres, espaces, tirets
    .trim()
    .replace(/\s+/g, '-')            // espaces → tirets
    .replace(/-+/g, '-');            // tirets multiples → un seul
}

/**
 * Nettoie une chaîne pour insertion HTML sécurisée
 * @param {string} str
 * @returns {string}
 */
export function sanitize(str) {
  if (!str || typeof str !== 'string') return '';

  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#x27;');
}

/**
 * Convertit un tableau de chaînes en liste HTML <ul>
 * @param {string[]} items
 * @param {string} className
 * @returns {string}
 */
export function formatListToHTML(items, className = '') {
  if (!Array.isArray(items) || items.length === 0) return '';

  const classAttr = className ? ` class="${className}"` : '';
  const listItems = items
    .map(item => `    <li>${sanitize(String(item))}</li>`)
    .join('\n');

  return `<ul${classAttr}>\n${listItems}\n</ul>`;
}

/**
 * Génère un slug unique pour un lead
 * @param {Object} lead
 * @returns {string}
 */
export function generateSlug(lead) {
  const parts = [
    lead.name || '',
    lead.city || '',
    'demo',
  ].filter(Boolean);

  return slugify(parts.join(' '));
}

/**
 * Pause asynchrone
 * @param {number} ms
 * @returns {Promise<void>}
 */
export function sleep(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

/**
 * Exécute une fonction avec retry automatique
 * @param {Function} fn - fonction async à exécuter
 * @param {number} attempts - nombre de tentatives
 * @param {number} delay - délai entre tentatives (ms)
 * @returns {Promise<any>}
 */
export async function withRetry(fn, attempts = 2, delay = 1000) {
  let lastError;

  for (let i = 0; i < attempts; i++) {
    try {
      return await fn();
    } catch (error) {
      lastError = error;
      if (i < attempts - 1) {
        console.warn(`  ⚠️  Tentative ${i + 1} échouée, retry dans ${delay}ms...`);
        await sleep(delay);
      }
    }
  }

  throw lastError;
}

/**
 * Log formaté avec timestamp
 * @param {string} level - 'info' | 'success' | 'error' | 'warn'
 * @param {string} message
 */
export function log(level, message) {
  const timestamp = new Date().toLocaleTimeString('fr-FR');
  const icons = {
    info: '📋',
    success: '✅',
    error: '❌',
    warn: '⚠️ ',
  };
  const icon = icons[level] || '•';
  console.log(`[${timestamp}] ${icon}  ${message}`);
}