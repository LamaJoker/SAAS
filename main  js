import { readFile, writeFile } from 'fs/promises';
import { join } from 'path';
import { config } from './config.js';
import { generateAllContent } from './generator.js';
import { buildAllSites } from './builder.js';
import { deployAll, printDeployReport } from './deploy.js';
import { log } from './utils.js';

/**
 * Charge et valide les leads depuis le fichier JSON
 * @returns {Promise<Object[]>}
 */
async function loadLeads() {
  let raw;
  try {
    raw = await readFile(config.paths.leads, 'utf-8');
  } catch (error) {
    throw new Error(`Impossible de lire le fichier leads: ${config.paths.leads}\n${error.message}`);
  }

  let leads;
  try {
    leads = JSON.parse(raw);
  } catch (error) {
    throw new Error(`Fichier leads JSON invalide: ${error.message}`);
  }

  if (!Array.isArray(leads)) {
    throw new Error('Le fichier leads doit contenir un tableau JSON');
  }

  // Validation basique
  const validLeads = leads.filter(lead => {
    const isValid = lead.name && lead.activity && lead.city;
    if (!isValid) {
      log('warn', `Lead ignoré (champs manquants): ${JSON.stringify(lead)}`);
    }
    return isValid;
  });

  log('info', `${validLeads.length} lead(s) valides chargés sur ${leads.length}`);
  return validLeads;
}

/**
 * Sauvegarde le rapport complet en JSON
 * @param {Object} report
 */
async function saveReport(report) {
  const reportPath = join(config.paths.output, 'report.json');
  await writeFile(reportPath, JSON.stringify(report, null, 2), 'utf-8');
  log('info', `Rapport sauvegardé: ${reportPath}`);
}

/**
 * Pipeline principal — point d'entrée du système
 */
async function main() {
  console.log('\n' + '🚀 '.repeat(20));
  console.log('AUTO-DEMO SYSTEM — Démarrage du pipeline');
  console.log('🚀 '.repeat(20) + '\n');

  const startTime = Date.now();

  try {
    // ÉTAPE 1 : Chargement des leads
    log('info', '═══ ÉTAPE 1/4 : Chargement des leads ═══');
    const leads = await loadLeads();

    // ÉTAPE 2 : Génération du contenu IA
    log('info', '═══ ÉTAPE 2/4 : Génération contenu IA ═══');
    const { leads: enrichedLeads, stats: genStats } = await generateAllContent(leads);

    // ÉTAPE 3 : Construction des sites HTML
    log('info', '═══ ÉTAPE 3/4 : Construction des sites HTML ═══');
    const buildResults = await buildAllSites(enrichedLeads);

    // ÉTAPE 4 : Déploiement et génération des URLs
    log('info', '═══ ÉTAPE 4/4 : Déploiement et URLs ═══');
    const deployResults = await deployAll(buildResults);

    // Rapport final
    const duration = ((Date.now() - startTime) / 1000).toFixed(2);

    const report = {
      generatedAt: new Date().toISOString(),
      duration: `${duration}s`,
      stats: {
        ...genStats,
        built: buildResults.filter(r => r.status === 'built').length,
        deployed: deployResults.length,
      },
      sites: deployResults,
    };

    await saveReport(report);
    printDeployReport(deployResults);

    log('success', `Pipeline terminé en ${duration}s`);

  } catch (error) {
    log('error', `Erreur critique du pipeline: ${error.message}`);
    console.error(error);
    process.exit(1);
  }
}

// Lancement
main();