# ════════════════════════════════════════════════════════════════════════════
#  AutoDemo SaaS — configuration
#  Copiez en .env et remplissez. Générez un secret : openssl rand -hex 48
# ════════════════════════════════════════════════════════════════════════════

# ── Serveur ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
BASE_URL=https://votre-domaine.fr          # URL publique (liens démos, emails)
CORS_ORIGIN=https://votre-domaine.fr        # requis en prod (liste séparée par ,)

# ── Sécurité (OBLIGATOIRE) ────────────────────────────────────────────────────
JWT_SECRET=                                  # ≥32 caractères — openssl rand -hex 48
JWT_EXPIRY=30d

# ── Base de données / fichiers ────────────────────────────────────────────────
DB_PATH=./data/saas.db
OUTPUT_DIR=./output

# ── IA (génération de contenu) ────────────────────────────────────────────────
AI_API_KEY=                                  # vide → mode mock (sites génériques)
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_MOCK_MODE=false
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.7

# ── Crédits ───────────────────────────────────────────────────────────────────
CREDITS_DEFAULT=10
CREDITS_PER_GEN=1

# ── SMTP (envoi email) ────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=AutoDemo
SMTP_FROM=
# Multi-comptes (rotation) : JSON [{host,port,user,pass,senderName,hourlyLimit}]
# SMTP_POOL_JSON=

# ── Paiement Stripe (npm i stripe) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Facturation & mentions légales (factures + pages /legal + footer emails) ──
BILLING_SELLER_NAME=AutoDemo
BILLING_SELLER_ADDRESS=                       # adresse postale (oblig. cold email + factures)
BILLING_SELLER_SIRET=
BILLING_SELLER_VAT=                           # ex: FR12345678901
BILLING_SELLER_COUNTRY=FR
BILLING_SELLER_EMAIL=
BILLING_VAT_RATE=20
LEGAL_FORM=                                   # SAS, SARL, EI…
LEGAL_CAPITAL=
LEGAL_RCS=
LEGAL_DIRECTOR=                              # directeur de la publication
LEGAL_DPO_EMAIL=                            # contact RGPD
LEGAL_HOSTING=                              # hébergeur (nom + adresse)

# ── Délivrabilité ─────────────────────────────────────────────────────────────
# DKIM : signe les emails. La clé publique doit être publiée en DNS (cf DEPLOY.md)
DKIM_DOMAIN=
DKIM_SELECTOR=default
DKIM_PRIVATE_KEY=                            # PEM (\n échappés acceptés)
# Warmup : montée en charge progressive du volume d'envoi
WARMUP_ENABLED=false
WARMUP_START=20
WARMUP_STEP=20
WARMUP_MAX=200
# Prospection B2B : 'block' n'envoie pas aux adresses perso (gmail…), 'allow' force
COLD_EMAIL_PERSONAL=block

# ── ① Enrichissement email des leads scrapés ──────────────────────────────────
ENRICHMENT_ENABLED=false
ENRICHMENT_PROVIDER=website                  # website | api
ENRICHMENT_API_URL=
ENRICHMENT_API_KEY=

# ── ① bis Canal WhatsApp (npm i twilio) ───────────────────────────────────────
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── ② Réponses entrantes ──────────────────────────────────────────────────────
INBOUND_ENABLED=false
INBOUND_SECRET=                              # protège POST /inbound/<secret>
# Poller IMAP optionnel (npm i imapflow) — sinon utilisez le webhook
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_POLL_SECONDS=120

# ── ④ Images des démos ────────────────────────────────────────────────────────
DEMO_IMAGES_PROVIDER=none                    # none | loremflickr

# ── ⑤ Filtre Apple Mail Privacy Protection ────────────────────────────────────
APMP_FILTER_ENABLED=true
APMP_PREFETCH_SECONDS=10

# ── Scraper Google Maps (npm i playwright && npx playwright install chromium) ──
SCRAPER_HEADLESS=true
SCRAPE_WORKER_EXTERNAL=false                 # true = scraper dans son propre process
GEN_CONCURRENCY=3

# ── Mise à l'échelle multi-instance (cf docs/scaling.md) ──────────────────────
REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=sqlite                          # sqlite | bullmq (npm i bullmq ioredis)
RATE_LIMIT_DRIVER=memory                     # memory | redis (npm i ioredis)
DB_DRIVER=sqlite                             # sqlite | postgres (cutover : cf docs/scaling.md)
DATABASE_URL=                                # postgres://user:pass@host:5432/autodemo (npm i pg)
PG_POOL_MAX=10

# ── Observabilité ─────────────────────────────────────────────────────────────
LOG_LEVEL=info                               # debug | info | warn | error
LOG_TO_FILE=true
LOG_RETENTION_DAYS=14
ERROR_WEBHOOK_URL=                           # Slack/Discord : alerte sur erreur 500
BACKUP_KEEP=7                                # nb de backups SQLite quotidiens gardés
